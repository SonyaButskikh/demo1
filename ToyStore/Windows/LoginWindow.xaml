<Window x:Class="ToyStore.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Height="520"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Arial"
        Icon="/Images/icon.ico"
        Background="#FFFFFF">

    <Grid Margin="20">
        <Border Background="#F5DEB3"
                CornerRadius="10"
                Padding="20">

            <StackPanel>
                <Image Source="/Images/icon.png"
                       Width="60"
                       Height="60"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 15"/>

                <TextBlock Text="Авторизация"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <TextBlock Text="Логин"
                           FontSize="16"/>

                <TextBox x:Name="LoginTextBox"
                         Height="35"
                         FontSize="16"
                         Margin="0 5 0 15"/>

                <TextBlock Text="Пароль"
                           FontSize="16"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="35"
                             FontSize="16"
                             Margin="0 5 0 25"/>

                <Button x:Name="LoginButton"
                        Content="Войти"
                        Height="40"
                        FontSize="16"
                        Background="#DEB887"
                        Click="LoginButton_Click"/>

                <Button x:Name="GuestButton"
                        Content="Войти как гость"
                        Height="40"
                        FontSize="16"
                        Background="#FFDEAD"
                        Margin="0 15 0 0"
                        Click="GuestButton_Click"/>
            </StackPanel>

        </Border>
    </Grid>
</Window>