<Window x:Class="ToyStore.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial"
        Icon="/Images/icon.ico"
        Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Background="#F5DEB3"
                Padding="10"
                CornerRadius="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Images/icon.png"
                       Width="60"
                       Height="60"
                       Stretch="Uniform"
                       Margin="0 0 15 0"/>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Center">

                    <TextBlock x:Name="SearchTextBlock"
                               Text="Поиск:"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Margin="0 0 10 0"/>

                    <TextBox x:Name="SearchTextBox"
                             Width="150"
                             Height="30"
                             FontSize="14"
                             Margin="0 0 12 0"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <TextBlock x:Name="FilterTextBlock"
                               Text="Поставщик:"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Margin="0 0 10 0"/>

                    <ComboBox x:Name="FilterComboBox"
                              Width="150"
                              Height="30"
                              Margin="0 0 12 0"
                              SelectionChanged="FilterComboBox_SelectionChanged"/>

                    <TextBlock x:Name="SortTextBlock"
                               Text="Сортировка:"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Margin="0 0 10 0"/>

                    <ComboBox x:Name="SortComboBox"
                              Width="150"
                              Height="30"
                              Margin="0 0 12 0"
                              SelectionChanged="SortComboBox_SelectionChanged"/>

                    <Button x:Name="AddButton"
                            Content="Добавить"
                            Width="90"
                            Height="35"
                            Margin="0 0 8 0"
                            Background="#DEB887"
                            Click="AddButton_Click"/>

                    <Button x:Name="EditButton"
                            Content="Ред."
                            Width="70"
                            Height="35"
                            Margin="0 0 8 0"
                            Background="#DEB887"
                            Click="EditButton_Click"/>

                    <Button x:Name="DeleteButton"
                            Content="Удалить"
                            Width="80"
                            Height="35"
                            Background="#DEB887"
                            Click="DeleteButton_Click"/>
                </WrapPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="10 0 0 0">

                    <TextBlock x:Name="UserTextBlock"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               Margin="0 0 10 0"/>

                    <Button x:Name="ExitButton"
                            Content="Выйти"
                            Width="90"
                            Height="35"
                            Background="#DEB887"
                            Click="ExitButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="CountTextBlock"
                   Grid.Row="1"
                   FontSize="16"
                   Margin="10"
                   FontWeight="Bold"/>

        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="0 10 0 0"
                  SelectionMode="Single"
                  RowHeight="100"
                  LoadingRow="ProductsDataGrid_LoadingRow">

            <DataGrid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Фото" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="80"
                                   Height="80"
                                   Stretch="Uniform"
                                   Source="{Binding Фото}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding Артикул}"
                                    Width="90"/>

                <DataGridTextColumn Header="Наименование"
                                    Binding="{Binding [Наименование товара]}"
                                    Width="210"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding [Описание товара]}"
                                    Width="260"/>

                <DataGridTemplateColumn Header="Цена" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding СтараяЦена}"
                           Foreground="Red"
                           TextDecorations="Strikethrough"/>

                                <TextBlock Text="{Binding НоваяЦена}"
                           Foreground="Black"
                           FontWeight="Bold"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Скидка"
                                    Binding="{Binding [Действующая скидка], StringFormat={}{0}%}"
                                    Width="70"/>

                <DataGridTextColumn Header="Остаток"
                                    Binding="{Binding [Кол-во на складе]}"
                                    Width="70"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding [Категория товара]}"
                                    Width="140"/>

                <DataGridTextColumn Header="Поставщик"
                                    Binding="{Binding Поставщик}"
                                    Width="140"/>

                <DataGridTextColumn Header="Производитель"
                                    Binding="{Binding Производитель}"
                                    Width="140"/>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>